local Players=game:GetService("Players")local TextChatService=game:GetService("TextChatService")local Lighting=game:GetService("Lighting")local ID=382538059 local COLOR=Color3.fromRGB(255,0,0)local T=.65 local A="rbxassetid://8408806737"local function glow(p)local c=p.Character if not c then return end local h=c:FindFirstChildOfClass("Humanoid")if not h then return end local d=h:GetAppliedDescription()if tonumber(d.Shirt)~=ID then return end local x=c:FindFirstChildOfClass("Highlight")if x then x:Destroy()end x=Instance.new("Highlight")x.Name="OPHighlight"x.Adornee=c x.FillColor=COLOR x.OutlineColor=COLOR x.FillTransparency=0 x.OutlineTransparency=0 x.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop x.Parent=c end local function red(c)return c.R>=T and c.R>c.G*1.35 and c.R>c.B*1.35 end local function isred(p)local c=p.Character if not c then return false end for _,o in ipairs(c:GetDescendants())do if o:IsA("BasePart")and red(o.Color)then return true end end return false end local function sky()local s=Lighting:FindFirstChild("C00lkidSky")if s then s:Destroy()end s=Instance.new("Sky")s.Name="C00lkidSky"s.SkyboxBk=A s.SkyboxDn=A s.SkyboxFt=A s.SkyboxLf=A s.SkyboxRt=A s.SkyboxUp=A s.CelestialBodiesShown=false s.StarCount=0 s.Parent=Lighting end local function nosky()local s=Lighting:FindFirstChild("C00lkidSky")if s then s:Destroy()end end local function chat(p,m)m=m:lower():match("^%s*(.-)%s*$")if m=="/op"then task.wait(.2)glow(p)elseif m=="/sky"then if isred(p)then sky()end elseif m=="/nosky"then nosky()end end for _,p in ipairs(Players:GetPlayers())do p.Chatted:Connect(function(m)chat(p,m)end)end Players.PlayerAdded:Connect(function(p)p.Chatted:Connect(function(m)chat(p,m)end)end)if TextChatService.ChatVersion==Enum.ChatVersion.TextChatService then TextChatService.MessageReceived:Connect(function(m)local s=m.TextSource if s then local p=Players:GetPlayerByUserId(s.UserId)if p then chat(p,m.Text)end end end)end
