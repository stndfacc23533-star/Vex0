local function tw(o,t,p,s,d)
return TweenService:Create(o,TweenInfo.new(t,s or Enum.EasingStyle.Quint,d or Enum.EasingDirection.Out),p)
end
local function part(s,c,m,tr,parent)
local p=Instance.new("Part")
p.Size=s
p.Color=c
p.Material=m or Enum.Material.Neon
p.Transparency=tr or 0
p.Anchored=true
p.CanCollide=false
p.CanTouch=false
p.CanQuery=false
p.CastShadow=false
p.Parent=parent
return p
end
local function ball(s,c,tr,parent)
local p=part(Vector3.new(s,s,s),c,Enum.Material.Neon,tr,parent)
p.Shape=Enum.PartType.Ball
return p
end
local function sound(id,vol,pitch)
local s=Instance.new("Sound")
s.SoundId="rbxassetid://"..id
s.Volume=vol
s.PlaybackSpeed=pitch or 1
s.Parent=SoundService
s:Play()
return s
end
