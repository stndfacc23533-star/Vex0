local function findTarget(name)
	if name == "all" then return "all" end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name):sub(1, #name) == name or string.lower(p.DisplayName):sub(1, #name) == name then
			return p
		end
	end
	return nil
end

local function getNearestPlayer()
	local localCharacter = Player.Character
	if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then 
		return nil 
	end
	
	local closestPlayer = nil
	local shortestDistance = math.huge
	local localPosition = localCharacter.HumanoidRootPart.Position
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local targetPosition = p.Character.HumanoidRootPart.Position
			local distance = (localPosition - targetPosition).Magnitude
			
			if distance < shortestDistance then
				shortestDistance = distance
				closestPlayer = p
			end
		end
	end
	
	return closestPlayer
end

local function customExplodeKill(targetPlayerObj)
	if not targetPlayerObj or not targetPlayerObj.Character then return end
	local targetChar = targetPlayerObj.Character
	local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
	local originalHealth = humanoid and humanoid.Health or 100
	local originalTransparencies = {}
	
	if humanoid then
		humanoid.Health = 0
	end
	
	targetChar.Archivable = true
	local explodeClone = targetChar:Clone()
	explodeClone.Parent = workspace
	
	for _, part in ipairs(targetChar:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			originalTransparencies[part] = part.Transparency
			part.Transparency = 1
		end
	end
	
	explodeClone:BreakJoints()
	for _, part in ipairs(explodeClone:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Velocity = Vector3.new(math.random(-10, 10), math.random(10, 30), math.random(-10, 10))
		end
	end
	
	task.wait(4)
	explodeClone:Destroy()
	
	local spawnLocation = workspace:FindFirstChildOfClass("SpawnLocation")
	local spawnPosition = spawnLocation and spawnLocation.Position or Vector3.new(0, 10, 0)
	
	local runnerClone = targetChar:Clone()
	local runnerHumanoid = runnerClone:FindFirstChildOfClass("Humanoid")
	runnerClone.Parent = workspace
	runnerClone:MoveTo(spawnPosition)
	
	if runnerHumanoid then
		runnerHumanoid.MaxHealth = originalHealth
		runnerHumanoid.Health = originalHealth
		runnerHumanoid.WalkSpeed = 16
	end
	
	for _, part in ipairs(runnerClone:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.Transparency = 0
		end
	end
	
	for _, part in ipairs(runnerClone:GetDescendants()) do
		if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Chest") then
			part.Transparency = 1
		end
	end
	
	local forceField = Instance.new("ForceField")
	forceField.Parent = runnerClone
	
	if humanoid then
		humanoid.Health = originalHealth
	end
	
	local localCounter = 0
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		if not runnerClone or not runnerClone:FindFirstChild("HumanoidRootPart") or not targetChar:FindFirstChild("HumanoidRootPart") then
			if connection then connection:Disconnect() end
			return
		end
		
		local targetRoot = targetChar.HumanoidRootPart
		local runnerRoot = runnerClone.HumanoidRootPart
		
		if runnerHumanoid then
			runnerHumanoid:MoveTo(targetRoot.Position)
		end
		
		for _, part in ipairs(runnerClone:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Chest") then
				part.Transparency = 1
			end
		end
		
		local torso = runnerClone:FindFirstChild("Torso")
		if torso then
			local rLeg = torso:FindFirstChild("Right Hip")
			local lLeg = torso:FindFirstChild("Left Hip")
			local rArm = torso:FindFirstChild("Right Shoulder")
			local lArm = torso:FindFirstChild("Left Shoulder")
			
			if runnerHumanoid.FloorMaterial == Enum.Material.Air then
				if rLeg then rLeg.CurrentAngle = 0.3 end
				if lLeg then lLeg.CurrentAngle = -0.2 end
				if rArm then rArm.CurrentAngle = 2.8 end
				if lArm then lArm.CurrentAngle = -2.8 end
			else
				localCounter = localCounter + (dt * 24)
				local angle = math.sin(localCounter) * 0.7
				if rLeg then rLeg.CurrentAngle = angle end
				if lLeg then lLeg.CurrentAngle = angle end
				if rArm then rArm.CurrentAngle = -angle end
				if lArm then lArm.CurrentAngle = -angle end
			end
		end
		
		if (runnerRoot.Position - targetRoot.Position).Magnitude < 4 then
			if connection then connection:Disconnect() end
			runnerClone:Destroy()
			
			for part, originalValue in pairs(originalTransparencies) do
				if part and part.Parent then
					part.Transparency = originalValue
				end
			end
		end
	end)
end

local function setVisibility(target, state)
	local char = target.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("Decal") then
				if not part:GetAttribute("OrigTrans") then
					part:SetAttribute("OrigTrans", part.Transparency)
				end
				part.Transparency = state and part:GetAttribute("OrigTrans") or 1
			end
		end
		local head = char:FindFirstChild("Head")
		if head then
			local billboard = head:FindFirstChildOfClass("BillboardGui")
			if billboard then billboard.Enabled = state end
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid.DisplayDistanceType = state and Enum.HumanoidDisplayDistanceType.Viewer or Enum.HumanoidDisplayDistanceType.None end
		end
	end
end

local function removeClone()
	if bodyClone then bodyClone:Destroy() bodyClone = nil end
	if platform then platform:Destroy() platform = nil end
	
	if targetPlayer and targetPlayer.Character then
		local char = targetPlayer.Character
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local rootPart = char:FindFirstChild("HumanoidRootPart")
		
		if rootPart then
			rootPart.CFrame = rootPart.CFrame * CFrame.new(0, TELEPORT_DEPTH, 0)
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
		
		if humanoid then
			if targetPlayer == Player then
				Camera.CameraSubject = humanoid
			end
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
		
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
	targetPlayer = nil
end

local function setupClone(char)
	if not isInvisible or not char then return end
	char.Archivable = true
	
	local humanoid = char:WaitForChild("Humanoid")
	local rootPart = char:WaitForChild("HumanoidRootPart")
	
	bodyClone = char:Clone()
	bodyClone.Name = "BodyClone"
	
	for _, child in ipairs(bodyClone:GetDescendants()) do
		if child:IsA("LocalScript") or child:IsA("Script") then
			child:Destroy()
		end
	end
	
	local cloneHumanoid = bodyClone:FindFirstChildOfClass("Humanoid")
	if cloneHumanoid then
		cloneHumanoid.PlatformStand = false
		cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	
	for _, part in ipairs(bodyClone:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
			part.Massless = false
			part.Transparency = CLONE_TRANSPARENCY
		elseif part:IsA("Accessory") then
			local handle = part:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				handle.Transparency = CLONE_TRANSPARENCY
			end
		end
	end
	
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
	
	platform = Instance.new("Part")
	platform.Size = Vector3.new(6, 1, 6)
	platform.Anchored = true
	platform.CanCollide = true
	platform.Transparency = 1
	platform.Parent = workspace
	
	bodyClone.Parent = workspace
	if targetPlayer == Player then
		Camera.CameraSubject = cloneHumanoid
	end
end

RunService.RenderStepped:Connect(function(dt)
	if not isInvisible or not targetPlayer or not targetPlayer.Character then return end
	
	local character = targetPlayer.Character
	if not character or not bodyClone or not platform or not character:FindFirstChild("HumanoidRootPart") or not bodyClone:FindFirstChild("HumanoidRootPart") then
		return
	end
	
	local myHumanoid = character:FindFirstChildOfClass("Humanoid")
	local cloneHumanoid = bodyClone:FindFirstChildOfClass("Humanoid")
	if not myHumanoid or not cloneHumanoid then return end
	
	local myRoot = character.HumanoidRootPart
	local cloneRoot = bodyClone.HumanoidRootPart
	
	local moveInput = myHumanoid.MoveDirection
