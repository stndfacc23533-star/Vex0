local function manipulateTargetPart(actionType, vectorValue)
	if not selectedPart or not selectedPart:IsDescendantOf(Workspace) then return end
	if selectedPart:IsA("Model") then
		if actionType == "M" then 
			selectedPart:TranslateBy(vectorValue * moveIncrement)
		elseif actionType == "R" then 
			selectedPart:PivotTo(selectedPart:GetPivot() * CFrame.fromEulerAnglesXYZ(math.rad(vectorValue.X * moveIncrement), math.rad(vectorValue.Y * moveIncrement), math.rad(vectorValue.Z * moveIncrement)))
		elseif actionType == "S" then 
			for _, childItem in ipairs(selectedPart:GetDescendants()) do 
				if childItem:IsA("BasePart") then childItem.Size = childItem.Size + (vectorValue * moveIncrement) end 
			end
		elseif actionType == "D" then 
			selectedPart:Destroy()
			clearBtoolsSelection()
		elseif actionType == "C" then 
			local clonedModel = selectedPart:Clone()
			clonedModel:TranslateBy(Vector3.new(0, 5, 0))
			clonedModel.Parent = Workspace
			createBtoolsSelectionBox(clonedModel:FindFirstChildWhichIsA("BasePart") or clonedModel)
		end
	elseif selectedPart:IsA("BasePart") then
		if actionType == "M" then 
			selectedPart.Position = selectedPart.Position + (vectorValue * moveIncrement)
		elseif actionType == "R" then 
			selectedPart.CFrame = selectedPart.CFrame * CFrame.fromEulerAnglesXYZ(math.rad(vectorValue.X * moveIncrement), math.rad(vectorValue.Y * moveIncrement), math.rad(vectorValue.Z * moveIncrement))
		elseif actionType == "S" then 
			local computedChange = vectorValue * moveIncrement
			if computedChange.X < 0 and (selectedPart.Size.X <= 0.1 or selectedPart.Size.Y <= 0.1 or selectedPart.Size.Z <= 0.1) then return end
			selectedPart.Size = selectedPart.Size + computedChange
		elseif actionType == "D" then 
			selectedPart:Destroy()
			clearBtoolsSelection()
		elseif actionType == "C" then 
			local clonedPart = selectedPart:Clone()
			clonedPart.Position = selectedPart.Position + Vector3.new(0, selectedPart.Size.Y, 0)
			clonedPart.Parent = Workspace
			createBtoolsSelectionBox(clonedPart)
		end 
	end 
end

