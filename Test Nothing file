	end
	
	if cloneHumanoid.FloorMaterial == Enum.Material.Air and myHumanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
		myHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	elseif cloneHumanoid.FloorMaterial ~= Enum.Material.Air and myHumanoid:GetState() == Enum.HumanoidStateType.Jumping then
		myHumanoid:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
	end
	
	platform.CFrame = myRoot.CFrame * CFrame.new(0, -3, 0)
	
	local realTool = character:FindFirstChildOfClass("Tool")
	local cloneTool = bodyClone:FindFirstChildOfClass("Tool")
	
	if realTool then
		local handle = realTool:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			if not cloneTool or cloneTool.Name ~= realTool.Name then
				if cloneTool then cloneTool:Destroy() end
