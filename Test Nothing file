			local cloneHandle = cloneTool:FindFirstChild("Handle")
			local rArm = bodyClone:FindFirstChild("Right Arm") or bodyClone:FindFirstChild("RightHand")
			if cloneHandle and cloneHandle:IsA("BasePart") and rArm then
