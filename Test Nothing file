local function toggleFreecam()
	local char = Player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	freecamEnabled = not freecamEnabled

	if freecamEnabled then
		freecamRealPos = root.CFrame
		root.Anchored = true
		
		freecamClone = Instance.new("Part")
		freecamClone.Size = Vector3.new(2, 2, 2)
		freecamClone.CFrame = freecamRealPos
		freecamClone.Transparency = 1
		freecamClone.CanCollide = false
		freecamClone.Anchored = true
		freecamClone.Parent = workspace
		
		Camera.CameraSubject = freecamClone
		
		freecamRenderConnection = RunService.RenderStepped:Connect(function()
			local curChar = Player.Character
			if not curChar then return end
			local curHum = curChar:FindFirstChildOfClass("Humanoid")
			
			if freecamEnabled and freecamClone and curHum then
				local moveInput = curHum.MoveDirection
				
				if moveInput.Magnitude > 0 then
					local camCFrame = Camera.CFrame
					local camLook = camCFrame.LookVector
					local camRight = camCFrame.RightVector
					
					local flatCamLook = Vector3.new(camLook.X, 0, camLook.Z)
					if flatCamLook.Magnitude > 0 then
						flatCamLook = flatCamLook.Unit
					else
						flatCamLook = Vector3.new(0, 0, -1)
					end
					
					local dotForward = moveInput:Dot(flatCamLook)
					local dotRight = moveInput:Dot(camRight)
					
					local moveVector = Vector3.new(0, 0, 0)
					
					if math.abs(dotForward) > math.abs(dotRight) then
						if dotForward > 0 then
							moveVector = camLook
						else
							moveVector = -camLook
						end
					else
						if dotRight > 0 then
							moveVector = camRight
						else
							moveVector = -camRight
						end
					end
					
					freecamClone.CFrame = freecamClone.CFrame + (moveVector.Unit * moveInput.Magnitude * freecamSpeed)
				end
			end
		end)
	else
		Camera.CameraSubject = hum
		root.Anchored = false
		root.CFrame = freecamRealPos
		
		freecamCleanup()
	end
end

