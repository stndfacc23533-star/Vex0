				if not weld then
					for _, v in ipairs(cloneHandle:GetChildren()) do
						if v:IsA("Weld") or v:IsA("ManualWeld") then v:Destroy() end
					end
					weld = Instance.new("ManualWeld")
					weld.Name = "RightGrip"
					weld.Part0 = rArm
					weld.Part1 = cloneHandle
					weld.C0 = CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)
					weld.C1 = realTool.Grip
					weld.Parent = cloneHandle
				end
			end
		end
	else
		if cloneTool then cloneTool:Destroy() end
	end
	
	local torso = bodyClone:FindFirstChild("Torso") or bodyClone:FindFirstChild("UpperTorso")
	if torso and bodyClone:FindFirstChild("Right Arm") then
