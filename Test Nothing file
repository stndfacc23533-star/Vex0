			discoConnection = RunService.Heartbeat:Connect(function()
				Lighting.Ambient = Color3.fromHSV(tick() % 5 / 5, 1, 1)
				Lighting.OutdoorAmbient = Color3.fromHSV(tick() % 5 / 5, 1, 1)
			end)
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Disco ambient skybox running."
		else
			if discoConnection then discoConnection:Disconnect() end
			Lighting.Ambient = Color3.fromRGB(0, 0, 0)
			Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Disco loop terminated."
		end
	elseif command == "freecam" then
		toggleFreecam()
		if freecamEnabled then
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Freecam framework launched."
		else
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Freecam framework detached."
		end
	elseif command == "reset" then
		if freecamEnabled then
			toggleFreecam()
		end
		if flying then stopFlying() end
		if isSpinning then stopSpinning() end
		if isInvisible then isInvisible = false removeClone() end
		if godModeActive then stopGodMode() end
		if noclipActive then stopNoclip() end
		
