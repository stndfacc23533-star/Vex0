					effect.Name = "ClientAdminEffect"
					effect.Parent = target.Character.HumanoidRootPart
					MenuLabel.Text = MenuLabel.Text .. "\n[>] Embedded particle elements to: " .. target.Name
				end
			end
		end
	elseif command == "disco" then
		discoActive = not discoActive
