		local cloneRoot = staticClone:FindFirstChild("HumanoidRootPart")
		if cloneRoot then
			cloneRoot.CFrame = Character.HumanoidRootPart.CFrame
		end
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Spawned static copy."
