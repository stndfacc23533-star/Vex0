local function startFlying(customSpeed)
	if flyConnection then flyConnection:Disconnect() end
	flying = true
	
	flySpeed = customSpeed or 50
	currentVelocity = Vector3.new(0, 0, 0)
	targetVelocity = Vector3.new(0, 0, 0)
	
	Character = Player.Character or Player.CharacterAdded:Wait()
	local humanoid = Character:FindFirstChildOfClass("Humanoid")
	local rootPart = Character:FindFirstChild("HumanoidRootPart")
	
	if humanoid and rootPart then
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			track:Stop()
		end
		
		flyConnection = RunService.RenderStepped:Connect(function()
			if not flying or not rootPart or not Character:IsDescendantOf(workspace) then
				if flyConnection then flyConnection:Disconnect() end
				return
			end
			
			humanoid.PlatformStand = true
			for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
				track:Stop()
			end
			
			local moveDir = humanoid.MoveDirection
			local camCF = Camera.CFrame
			targetVelocity = Vector3.new(0, 0, 0)
			
			if moveDir.Magnitude > 0 then
				local flatCamLook = (camCF.LookVector * Vector3.new(1, 0, 1)).Unit
				local flatCamRight = (camCF.RightVector * Vector3.new(1, 0, 1)).Unit
				
				local localZ = moveDir:Dot(flatCamLook)
				local localX = moveDir:Dot(flatCamRight)
				
				local customDir = (camCF.LookVector * localZ) + (camCF.RightVector * localX)
				if customDir.Magnitude > 0 then
					targetVelocity = customDir.Unit * flySpeed
				end
			end
			
			currentVelocity = currentVelocity:Lerp(targetVelocity, 0.12)
			rootPart.CFrame = CFrame.new(rootPart.Position + (currentVelocity * 0.1), rootPart.Position + camCF.LookVector * 10)
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end)
	end
end

