		if isInvisible then
			isInvisible = false
			removeClone()
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Deactivated invisibility."
		end
	elseif command == "btools" then
		btoolsGui = initializeBtoolsGuiPanel()
		btoolsGui.Parent = Player:WaitForChild("PlayerGui")
		
		if btoolsMouseConnection then btoolsMouseConnection:Disconnect() end
