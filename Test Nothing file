CommandInput.FocusLost:Connect(function(enterPressed)
	if not enterPressed or CommandInput.Text == "" then return end
	
	local rawText = CommandInput.Text
	CommandInput.Text = ""
	
	if string.sub(rawText, 1, 1) ~= ";" then
		MenuLabel.Text = MenuLabel.Text .. "\n[!] Error: Prefix command with ';'"
		return
	end
	
	local cleanText = string.sub(rawText, 2)
	local args = string.split(cleanText, " ")
	local command = string.lower(args[1])
	
	task.wait(math.random(2, 5) / 10)
	Character = Player.Character or Player.CharacterAdded:Wait()
	
	if command == "speed" then
		local hum = Character:FindFirstChildOfClass("Humanoid")
		local amt = tonumber(args[2]) or 16
		if hum then
			hum.WalkSpeed = amt
			MenuLabel.Text = MenuLabel.Text .. "\n[>] WalkSpeed: " .. tostring(amt)
		end
	elseif command == "jump" then
		local hum = Character:FindFirstChildOfClass("Humanoid")
		local amt = tonumber(args[2]) or 50
		if hum then
			hum.UseJumpPower = true
			hum.JumpPower = amt
			MenuLabel.Text = MenuLabel.Text .. "\n[>] JumpPower: " .. tostring(amt)
		end
	elseif command == "gravity" then
		local amt = tonumber(args[2]) or 196.2
		Workspace.Gravity = amt
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Gravity: " .. tostring(amt)
	elseif command == "nofog" then
		Lighting.FogEnd = 999999
		Lighting.FogStart = 999999
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Fog disabled."
	elseif command == "fullbright" then
		Lighting.Ambient = Color3.fromRGB(255, 255, 255)
		Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		Lighting.Brightness = 2
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Fullbright active."
	elseif command == "m" then
		table.remove(args, 1)
		local msgString = table.concat(args, " ")
		if msgString ~= "" then
			displayMessage(msgString)
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Broadcast transmitted."
		end
	elseif command == "kill" then
		if args[2] and string.lower(args[2]) == "all" then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= Player and p.Character then
					task.spawn(customExplodeKill, p)
				end
			end
			MenuLabel.Text = MenuLabel.Text .. "\n[>] Triggered explosion runner loop on all players."
		else
			local target = nil
			if args[2] then
				target = findTarget(string.lower(args[2]))
			else
				target = getNearestPlayer()
			end
			
			if target and target.Character then
				task.spawn(customExplodeKill, target)
				MenuLabel.Text = MenuLabel.Text .. "\n[>] Explosion loop tracking target: " .. target.Name
			else
				MenuLabel.Text = MenuLabel.Text .. "\n[!] Target missing or no player nearby."
			end
		end
	elseif command == "ban" or command == "kick" then
		if args[2] then
			local target = findTarget(string.lower(args[2]))
			if target and target ~= "all" then
				setVisibility(target, false)
				MenuLabel.Text = MenuLabel.Text .. "\n[>] Cloaked (Simulation): " .. target.Name
			else
				MenuLabel.Text = MenuLabel.Text .. "\n[!] Invalid subject."
			end
		end
	elseif command == "unban" or command == "unkick" then
		if args[2] then
			local target = findTarget(string.lower(args[2]))
			if target and target ~= "all" then
				setVisibility(target, true)
				MenuLabel.Text = MenuLabel.Text .. "\n[>] Decloaked (Simulation): " .. target.Name
			else
				MenuLabel.Text = MenuLabel.Text .. "\n[!] Invalid subject."
			end
		end
	elseif command == "fly" then
		local chosenSpeed = tonumber(args[2]) or 50
		startFlying(chosenSpeed)
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Flight protocol initiated at speed: " .. tostring(chosenSpeed)
	elseif command == "unfly" then
		stopFlying()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Flight protocol deactivated."
	elseif command == "tp" then
		if args[2] then
			local target = findTarget(string.lower(args[2]))
			if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				local myRoot = Character:FindFirstChild("HumanoidRootPart")
				if myRoot then
					myRoot.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
					MenuLabel.Text = MenuLabel.Text .. "\n[>] Teleported to specific player: " .. target.Name
				end
			else
				MenuLabel.Text = MenuLabel.Text .. "\n[!] Target character not located."
			end
		else
			MenuLabel.Text = MenuLabel.Text .. "\n[!] Specify player name."
		end
	elseif command == "tpme" then
		if args[2] then
			local target = findTarget(string.lower(args[2]))
			if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
				local myRoot = Character:FindFirstChild("HumanoidRootPart")
				if targetRoot and myRoot then
					targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -2)
					MenuLabel.Text = MenuLabel.Text .. "\n[>] Teleported " .. target.Name .. " to you."
				end
			else
				MenuLabel.Text = MenuLabel.Text .. "\n[!] Target missing."
			end
		end
	elseif command == "god" then
		startGodMode()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] God mode activated."
	elseif command == "ungod" then
		stopGodMode()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] God mode deactivated."
	elseif command == "noclip" then
		startNoclip()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Noclip enabled."
	elseif command == "clip" then
		stopNoclip()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Noclip disabled."
	elseif command == "control" then
		if args[2] then
			local target = findTarget(string.lower(args[2]))
			if target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") then
				if not isControlling then
					originalCameraSubject = Camera.CameraSubject
					isControlling = true
					Camera.CameraSubject = target.Character:FindFirstChildOfClass("Humanoid")
					
					controlledConnection = RunService.RenderStepped:Connect(function()
						local myHum = Character:FindFirstChildOfClass("Humanoid")
						local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
						if myHum and targetHum then
							targetHum:Move(myHum.MoveDirection, false)
							targetHum.Jump = myHum.Jump
						end
					end)
					MenuLabel.Text = MenuLabel.Text .. "\n[>] Controlling avatar: " .. target.Name
				else
					if controlledConnection then controlledConnection:Disconnect() end
					Camera.CameraSubject = originalCameraSubject or (Character:FindFirstChildOfClass("Humanoid"))
					isControlling = false
					MenuLabel.Text = MenuLabel.Text .. "\n[>] Terminated character control."
				end
			else
				MenuLabel.Text = MenuLabel.Text .. "\n[!] Control target invalid."
			end
		else
			if isControlling then
				if controlledConnection then controlledConnection:Disconnect() end
				Camera.CameraSubject = Character:FindFirstChildOfClass("Humanoid") or Camera.CameraSubject
				isControlling = false
				MenuLabel.Text = MenuLabel.Text .. "\n[>] Terminated character control."
			end
		end
	elseif command == "clone" then
