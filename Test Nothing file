				createBtoolsSelectionBox(targetElement) 
			else 
				clearBtoolsSelection() 
			end
		end)
		
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Embedded custom grid-BTools UI matrix."
	elseif command == "spin" then
		local speed = tonumber(args[2]) or 30
		startSpinning(speed)
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Avatar spin velocity locked: " .. tostring(speed)
	elseif command == "unspin" then
		stopSpinning()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Spin tracking terminated."
	elseif command == "cliente" then
		setupClientExecutor()
		MenuLabel.Text = MenuLabel.Text .. "\n[>] Multi-line runtime script executor window mounted."
	elseif command == "fire" or command == "smoke" or command == "sparkles" then
		if args[2] then
			local target = findTarget(string.lower(args[2]))
			if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				local effect = nil
				if command == "fire" then effect = Instance.new("Fire") effect.Heat = 25 effect.Size = 20
