		local staticClone = Character:Clone()
		staticClone.Name = "LocalConfusionClone"
		for _, part in ipairs(staticClone:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
				part.Anchored = true
			end
		end
