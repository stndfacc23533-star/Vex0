		Lighting.Ambient = Color3.fromRGB(0, 0, 0)
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		Lighting.Brightness = 1
		
		for _, v in ipairs(Workspace:GetChildren()) do
			if v.Name == "LocalConfusionClone" then v:Destroy() end
		end
		
		if btoolsGui then btoolsGui:Destroy() btoolsGui = nil end
		clearBtoolsSelection()
		if btoolsMouseConnection then btoolsMouseConnection:Disconnect() btoolsMouseConnection = nil end
		
